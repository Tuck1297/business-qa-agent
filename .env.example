# Copy to .env and fill in. `npm start` loads it automatically (Node 22.18+).

# ── Server ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8787
# Required whenever HOST isn't loopback (127.x, localhost, ::1). Use a long random string.
API_TOKEN=
# Used to resolve "this month", "last quarter", etc.
TIMEZONE=America/Chicago

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Decisions API model: routing and tool selection (typed answers, no text).
OPENAI_DECISION_MODEL=gpt-6-luna
# Responses API model: filling in tool parameters and writing the answer.
OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=60000

# ── Routing thresholds (0–1) ──────────────────────────────────────────────
# A predicate ("needs the database?") counts as yes at or above this probability.
# ROUTE_PREDICATE_THRESHOLD=0.5
# Ask the user a follow-up instead of answering when "is ambiguous" is at least this likely.
# ROUTE_CLARIFY_THRESHOLD=0.7
# Offer a database tool to the model when its Decisions probability is at least this.
# TOOL_SELECT_THRESHOLD=0.5

# ── Business database ─────────────────────────────────────────────────────
# Your database tools: the only SQL the agent can run (copy tools.example.json).
# Query results stay on this server; the model never sees them.
TOOLS_PATH=tools.json
# One connection string per source in tools.json, named by its "connectionEnv".
# Use a read-only database user.
SALES_DATABASE_URL=postgres://readonly_user:password@localhost:5432/sales
SUPPORT_DATABASE_URL=Server=localhost,1433;Database=support;User Id=readonly_user;Password=...;Encrypt=true;TrustServerCertificate=true
# MAX_ROWS=200
# QUERY_TIMEOUT_MS=10000
# Most tool calls per question (1–8).
# MAX_TOOL_CALLS=4
# Include each call's SQL and parameters in step events (sent to clients, never to the model).
# SHOW_SQL=true

# ── Formatting merge-field values ─────────────────────────────────────────
# LOCALE=en-US
# CURRENCY=USD

# ── Cloudflare AI Search (formerly AutoRAG) ───────────────────────────────
# Leave CF_AI_SEARCH_INSTANCE empty to turn document search off.
CF_AI_SEARCH_INSTANCE=
CF_ACCOUNT_ID=
# API token with AI Search Run permission.
CF_API_TOKEN=
# CF_AI_SEARCH_NAMESPACE=default
# CF_AI_SEARCH_MAX_RESULTS=10
# Minimum vector similarity (0–1) for a chunk to be used.
# CF_AI_SEARCH_MATCH_THRESHOLD=
# CF_AI_SEARCH_TIMEOUT_MS=15000
# Short description used when routing questions.
DOCUMENTS_DESCRIPTION=company documents such as policies, procedures and contracts
