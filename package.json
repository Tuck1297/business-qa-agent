{
  "name": "business-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Ask a question in plain language; an AI agent routes it with OpenAI's Decisions API, queries your business database and/or your Cloudflare AI Search (AutoRAG) documents, and streams every step back.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "catalog:draft": "node --env-file-if-exists=.env scripts/draft-catalog.ts"
  },
  "dependencies": {
    "mssql": "^11.0.1",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "typescript": "^5.9.0"
  }
}
